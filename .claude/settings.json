{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "UV_NO_ENV_FILE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npm test)",
      "Bash(npx prettier:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
