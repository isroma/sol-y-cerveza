{
  "name": "sol-y-cerveza-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply sol-y-cerveza --local",
    "migrate:remote": "wrangler d1 migrations apply sol-y-cerveza --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "4.164.0"
  }
}
