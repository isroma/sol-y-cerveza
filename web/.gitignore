# node_modules/, dist/, .env.*, .idea/ and .DS_Store: see the root .gitignore.
# web/ios and web/android have their own .gitignore.

# Local overrides (e.g. .env.local)
*.local
dist-ssr

# The root .vscode/* rule covers only the repo root, not a workspace opened at web/
.vscode/*
!.vscode/extensions.json

# Playwright (npm run e2e)
test-results
playwright-report
