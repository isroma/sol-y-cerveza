# Price suggestions API (see api/README.md). Leave unset to show curated prices only.
VITE_PRICES_API=https://sol-y-cerveza-api.<account>.workers.dev
# Turnstile site key (public). 1x00000000000000000000AA always passes, for local testing.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Admin view only (never VITE_-prefixed, so never sent to the browser): the API's ADMIN_TOKEN.
PRICES_ADMIN_TOKEN=
# Admin view only (never VITE_-prefixed): a Claude API key, for "Read prices from a photo".
# The dev server sends the photo to Anthropic's API; leave unset to type prices by hand.
ANTHROPIC_API_KEY=
# Admin view only: LiDAR rasters for the sun preview, if not the default
# pipeline/.cache/badajoz_dsm.tif and badajoz_dtm.tif (absolute, or relative to web/).
PROBE_DSM=
PROBE_DTM=
