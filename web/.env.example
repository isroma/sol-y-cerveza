# Price suggestions API (see api/README.md). Leave unset to show curated prices only.
VITE_PRICES_API=https://sol-y-cerveza-api.<account>.workers.dev
# Turnstile site key (public). 1x00000000000000000000AA always passes, for local testing.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Admin view only (never VITE_-prefixed, so never sent to the browser): the API's ADMIN_TOKEN.
PRICES_ADMIN_TOKEN=
